<?xml version="1.0" encoding="utf-8" ?>
<!--
    Rigged fish. Set species to load config/species/<species>.json and its generated
    .rig.json. swimSpeed (px/s) sets the tail/fin beat rate. Setting facing to 1 (right)
    or -1 (left) turns the fish: the rig narrows to its head-on thickness about
    mirror_center while it pitches nose-up and rises a little, crossfades to the rig's
    pre-mirrored art at the narrowest point, then widens nose-down with a slight
    overshoot. The tail lags the body both ways, so the head leads the turn. turnDelay
    (seconds) holds a turn back, which staggers a school; turning is true while it runs. paused holds the tail and fin beat (swimAnim) while true. The Fish origin is the body Poster's
    top-left corner.
    Night light organ (species json "night" block, flashlight fish): each set gets a glow
    Poster (id starting with "night", so Night and the lane tint leave it untinted) at the
    rig's glow.center, blinking on one repeating Animation drawn from blinkSeed (set it
    before species; 0 falls back to the creation order). Under ?freeze the blink is posed,
    not run. A nightOnly species follows m.global.nightLevel (set by components/Night):
    hidden at 0, opacity = level above it.
-->
<component name="Fish" extends="Group">
    <interface>
        <field id="species" type="string" onChange="onSpeciesChanged" />
        <field id="swimSpeed" type="float" value="60.0" onChange="onSwimSpeedChanged" />
        <field id="facing" type="integer" value="1" onChange="onFacingChanged" />
        <field id="turning" type="boolean" value="false" />
        <field id="turnDelay" type="float" value="0.0" />
        <field id="blinkSeed" type="integer" value="0" />
        <field id="paused" type="boolean" value="false" onChange="onPausedChanged" />
    </interface>
    <script type="text/brightscript" uri="Fish.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/prng.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/glow.brs" />
    <children>
        <Group id="rig">
            <Group id="base">
                <Poster id="body" />
                <Poster id="tail" />
                <Poster id="fin" />
            </Group>
            <Group id="mirrored" visible="false" opacity="0.0">
                <Poster id="mBody" />
                <Poster id="mTail" />
                <Poster id="mFin" />
            </Group>
        </Group>
        <Animation id="swimAnim" repeat="true" easeFunction="linear" duration="1.0">
            <FloatFieldInterpolator id="tailInterp" />
            <FloatFieldInterpolator id="finInterp" />
            <FloatFieldInterpolator id="mTailInterp" />
            <FloatFieldInterpolator id="mFinInterp" />
        </Animation>
        <Animation id="turnAnim" repeat="false" easeFunction="linear" duration="0.85">
            <Vector2DFieldInterpolator id="turnInterp" />
            <FloatFieldInterpolator id="turnRoll" />
            <Vector2DFieldInterpolator id="turnLift" />
            <Vector2DFieldInterpolator id="baseTailLag" />
            <Vector2DFieldInterpolator id="mirroredTailLag" />
            <FloatFieldInterpolator id="baseFade" />
            <FloatFieldInterpolator id="mirroredFade" />
        </Animation>
    </children>
</component>
