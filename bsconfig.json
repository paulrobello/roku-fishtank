{
  "rootDir": ".",
  "stagingDir": "dist/staging",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "config/**/*",
    "!source/preview.brs",
    "!source/preview_color.brs",
    "!components/Fidelity/**/*",
    "!images/fidelity/**/*"
  ],
  "createPackage": false,
  "retainStagingDir": false,
  "plugins": ["@rokucommunity/bslint"],
  "diagnosticFilters": [{ "src": "components/lib/**/*.brs", "codes": [1013] }],
  "lintConfig": "bslint.json"
}
